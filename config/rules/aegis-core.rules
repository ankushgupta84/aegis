alert http any any -> any any (msg:"AEGIS CORE XSS Cookie or location access in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"document."; pcre:"/document\.(?:cookie|domain|location|write)/"; \
    classtype:web-application-attack; sid:9000116; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE XSS Entity or escape encoded script tag in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"script"; pcre:"/(?:&lt\;?|&#0*60\;?|&#x0*3c\;?|\\u003c|\\x3c)\s*\/?script/"; \
    classtype:web-application-attack; sid:9000117; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE XSS Entity or escape encoded script tag in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"script"; pcre:"/(?:&lt\;?|&#0*60\;?|&#x0*3c\;?|\\u003c|\\x3c)\s*\/?script/"; \
    classtype:web-application-attack; sid:9000118; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)

# ==================================================================================================
# TRAVERSAL: path traversal and local file inclusion. Keys on dot-dot segments and on the files
# they are used to reach. One ../ is plausible (a relative link in a form, a ?next= value) and scores 3.
# Two or more in a row, or a named target (/etc/passwd, /proc/self/environ, win.ini, system32,
# WEB-INF), score 5. In bodies a target counts only after = & " or ../, because administrators
# legitimately write /etc/hosts in prose.
# ==================================================================================================

