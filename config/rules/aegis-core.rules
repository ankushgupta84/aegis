alert http any any -> any any (msg:"AEGIS CORE SQLI sleep() or pg_sleep() in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"sleep"; pcre:"/(?:^|[^.\w])(?:pg_)?sleep\s*\(\s*(?:\d|\$|@|\()/"; \
    classtype:web-application-attack; sid:9000016; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
