alert http any any -> any any (msg:"AEGIS CORE SQLI MySQL versioned comment in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"/*!"; pcre:"/\/\*!\d{0,5}/"; \
    classtype:web-application-attack; sid:9000025; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

# ==================================================================================================
# XSS: cross-site scripting. Keys on markup that executes: <script, <iframe, a tag carrying an
# on*= handler, javascript: followed by a call, data:text/html. Those score 5. A handler with no
# tag around it (it may sit inside an attribute the application already opened), alert(), reading
# document.cookie and HTML-entity-escaped tags score 3: documentation and code snippets mention
# them. javascript: is matched with whitespace stripped, so "java\tscript:" cannot dodge it.
# ==================================================================================================

alert http any any -> any any (msg:"AEGIS CORE XSS Script tag in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"<script"; \
    classtype:web-application-attack; sid:9000101; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS Script tag in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"<script"; \
    classtype:web-application-attack; sid:9000102; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS Script tag in header"; flow:to_server,established; \
    http.header; url_decode; url_decode; to_lowercase; \
    content:"<script"; \
    classtype:web-application-attack; sid:9000103; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE XSS Tag with event handler in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"<"; pcre:"/<[a-z][^>]{0,200}?[\s\/\"'`]on(?:abort|animation\w+|auxclick|before\w+|blur|cancel|change|click|close|contextmenu|copy|cut|dblclick|drag\w*|drop|end|ended|error|focus\w*|hashchange|input|invalid|key\w+|load\w*|message|mouse\w+|page\w+|paste|pause|play\w*|pointer\w+|popstate|reset|resize|scroll\w*|search|seek\w*|select\w*|show|start|submit|toggle|touch\w+|transition\w+|unload|wheel|begin|finish|repeat)\s*=/"; \
    classtype:web-application-attack; sid:9000104; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS Tag with event handler in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"<"; pcre:"/<[a-z][^>]{0,200}?[\s\/\"'`]on(?:abort|animation\w+|auxclick|before\w+|blur|cancel|change|click|close|contextmenu|copy|cut|dblclick|drag\w*|drop|end|ended|error|focus\w*|hashchange|input|invalid|key\w+|load\w*|message|mouse\w+|page\w+|paste|pause|play\w*|pointer\w+|popstate|reset|resize|scroll\w*|search|seek\w*|select\w*|show|start|submit|toggle|touch\w+|transition\w+|unload|wheel|begin|finish|repeat)\s*=/"; \
    classtype:web-application-attack; sid:9000105; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS Tag with event handler in header"; flow:to_server,established; \
    http.header; url_decode; url_decode; to_lowercase; \
    content:"<"; pcre:"/<[a-z][^>]{0,200}?[\s\/\"'`]on(?:abort|animation\w+|auxclick|before\w+|blur|cancel|change|click|close|contextmenu|copy|cut|dblclick|drag\w*|drop|end|ended|error|focus\w*|hashchange|input|invalid|key\w+|load\w*|message|mouse\w+|page\w+|paste|pause|play\w*|pointer\w+|popstate|reset|resize|scroll\w*|search|seek\w*|select\w*|show|start|submit|toggle|touch\w+|transition\w+|unload|wheel|begin|finish|repeat)\s*=/"; \
    classtype:web-application-attack; sid:9000106; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE XSS Bare event handler attribute in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"on"; pcre:"/[\s\"'\/\;>]on(?:abort|animation\w+|auxclick|before\w+|blur|cancel|change|click|close|contextmenu|copy|cut|dblclick|drag\w*|drop|end|ended|error|focus\w*|hashchange|input|invalid|key\w+|load\w*|message|mouse\w+|page\w+|paste|pause|play\w*|pointer\w+|popstate|reset|resize|scroll\w*|search|seek\w*|select\w*|show|start|submit|toggle|touch\w+|transition\w+|unload|wheel|begin|finish|repeat)\s*=/"; \
    classtype:web-application-attack; sid:9000107; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE XSS Bare event handler attribute in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"on"; pcre:"/[\s\"'\/\;>]on(?:abort|animation\w+|auxclick|before\w+|blur|cancel|change|click|close|contextmenu|copy|cut|dblclick|drag\w*|drop|end|ended|error|focus\w*|hashchange|input|invalid|key\w+|load\w*|message|mouse\w+|page\w+|paste|pause|play\w*|pointer\w+|popstate|reset|resize|scroll\w*|search|seek\w*|select\w*|show|start|submit|toggle|touch\w+|transition\w+|unload|wheel|begin|finish|repeat)\s*=/"; \
    classtype:web-application-attack; sid:9000108; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)

alert http any any -> any any (msg:"AEGIS CORE XSS javascript: URI scheme in URI"; flow:to_server,established; \
    http.uri; url_decode; strip_whitespace; to_lowercase; \
    content:"javascript:"; pcre:"/javascript:(?:alert|prompt|confirm|eval|fetch|void|document\.|window\.|location|top\.|self\.|this\.|history)/"; \
    classtype:web-application-attack; sid:9000109; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS javascript: URI scheme in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; strip_whitespace; to_lowercase; \
    content:"javascript:"; pcre:"/javascript:(?:alert|prompt|confirm|eval|fetch|void|document\.|window\.|location|top\.|self\.|this\.|history)/"; \
    classtype:web-application-attack; sid:9000110; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS data:text/html URI in URI"; flow:to_server,established; \
    http.uri; url_decode; strip_whitespace; to_lowercase; \
    content:"data:text/html"; \
    classtype:web-application-attack; sid:9000111; rev:1; \
