# ==================================================================================================
# PROBE: requests for files a web server should never serve: secrets, version-control metadata,
# application config, backups, debug endpoints. Secrets and VCS metadata score 5 (nobody fetches
# /.env by accident); low-signal dotfiles, SQL dumps and info pages score 3.
# ==================================================================================================

alert http any any -> any any (msg:"AEGIS CORE PROBE Secrets and credentials dotfile"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"/."; pcre:"/\/\.(?:env(?:\.[a-z0-9_-]{1,12})?(?:[?\/#&]|$)|aws\/|ssh\/|docker\/config|npmrc|pypirc|netrc|bash_history|mysql_history|htpasswd|gnupg\/|kube\/config)/"; \
    classtype:attempted-recon; sid:9000801; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE PROBE Version-control metadata"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"/."; pcre:"/\/\.(?:git(?:\/|$)|svn\/|hg\/|bzr\/)/"; \
    classtype:attempted-recon; sid:9000802; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE PROBE Low-signal dotfile"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"/."; pcre:"/\/\.(?:ds_store|htaccess|idea\/|vscode\/)/"; \
    classtype:attempted-recon; sid:9000803; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE PROBE WordPress wp-config file or backup"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"wp-config"; \
    classtype:attempted-recon; sid:9000804; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE PROBE SSH private key file"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"id_rsa"; \
    classtype:attempted-recon; sid:9000805; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE PROBE Spring Boot actuator sensitive endpoint"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"/actuator"; pcre:"/\/actuator\/(?:env|heapdump|threaddump|configprops|mappings|beans|loggers|jolokia|httptrace|gateway)/"; \
