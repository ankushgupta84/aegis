# Aegis core web-attack ruleset (Suricata 7 syntax, sids 9000001-9000899).
#
# Scoring: the WAF adds the `score` of every rule that matches and blocks at 5 or more.
#   5  a high-confidence attack on its own (union select, <script, ../../, ${jndi:).
#   3  suspicious but plausible in legitimate traffic: blocks only with a second signal
#      (a scanner user-agent, a quote-comment, a single ../, an encoding trick).
#   1-2 weak tips; none ship today.
#
# Views: every attack-class rule inspects one location, because a Suricata rule reads one buffer.
#   URI    http.uri; url_decode; to_lowercase   decoded once by the parser, once more here: a double-encoded
#                                                payload shows up here, and "+" becomes a space
#   BODY   http.request_body; url_decode; url_decode; to_lowercase   the body arrives raw, so two decodes give
#          form-encoded and JSON bodies the same single and double-encoding coverage as the URI
#   HEADER http.header; url_decode; url_decode; to_lowercase         every header line, including Cookie and Referer
# Because the lowercase view is searched, contents and regexes below are written in lowercase.
# Each rule keys its prefilter on one literal and leaves precision to pcre (RE2: no lookaround).
#
# Sid blocks: SQLI 9000001, XSS 9000101, TRAVERSAL 9000201, INCLUSION 9000301, CMDI 9000401,
#             EXPLOIT 9000501, EVASION 9000601, SCANNER 9000701, PROBE 9000801.

# ==================================================================================================
# SQLI: SQL injection. Keys on SQL structure (union select, quote then or/and then a comparison,
# stacked statements, time functions, schema probing), never on a lone keyword, so prose such as
# "please select one option and union the results" passes. Structural payloads score 5. A quote
# followed by a SQL comment (O'Brien --) and a select from a user table are plausible in real text
# and score 3. Equality tautologies are keyed on "=", so <, > and "like" variants are not covered.
# ==================================================================================================

alert http any any -> any any (msg:"AEGIS CORE SQLI UNION SELECT in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"union"; pcre:"/\bunion(?:\s|\/\*.*?\*\/|\()+(?:(?:all|distinct)(?:\s|\/\*.*?\*\/|\()+)?select\b(?:\s|\/\*.*?\*\/|\()*(?:[\d*@'\"`]|null\b|\w+(?:\s|\/\*.*?\*\/)*(?:,|\(|\bfrom\b))/"; \
    classtype:web-application-attack; sid:9000001; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI UNION SELECT in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"union"; pcre:"/\bunion(?:\s|\/\*.*?\*\/|\()+(?:(?:all|distinct)(?:\s|\/\*.*?\*\/|\()+)?select\b(?:\s|\/\*.*?\*\/|\()*(?:[\d*@'\"`]|null\b|\w+(?:\s|\/\*.*?\*\/)*(?:,|\(|\bfrom\b))/"; \
    classtype:web-application-attack; sid:9000002; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI UNION SELECT in header"; flow:to_server,established; \
    http.header; url_decode; url_decode; to_lowercase; \
    content:"union"; pcre:"/\bunion(?:\s|\/\*.*?\*\/|\()+(?:(?:all|distinct)(?:\s|\/\*.*?\*\/|\()+)?select\b(?:\s|\/\*.*?\*\/|\()*(?:[\d*@'\"`]|null\b|\w+(?:\s|\/\*.*?\*\/)*(?:,|\(|\bfrom\b))/"; \
    classtype:web-application-attack; sid:9000003; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then OR/AND tautology in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"="; pcre:"/['\"]\)*\s*(?:or|and|\|\||&&)\s*\(*\s*(?:['\"][^'\"]{0,30}['\"]?|\w+)\s*=\s*(?:['\"]|\w)/"; \
    classtype:web-application-attack; sid:9000004; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then OR/AND tautology in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"="; pcre:"/['\"]\)*\s*(?:or|and|\|\||&&)\s*\(*\s*(?:['\"][^'\"]{0,30}['\"]?|\w+)\s*=\s*(?:['\"]|\w)/"; \
    classtype:web-application-attack; sid:9000005; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then OR/AND tautology in header"; flow:to_server,established; \
    http.header; url_decode; url_decode; to_lowercase; \
    content:"="; pcre:"/['\"]\)*\s*(?:or|and|\|\||&&)\s*\(*\s*(?:['\"][^'\"]{0,30}['\"]?|\w+)\s*=\s*(?:['\"]|\w)/"; \
    classtype:web-application-attack; sid:9000006; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then OR true then comment in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"or"; pcre:"/['\"]\)*\s*(?:or|\|\|)\s*(?:true|\d+|['\"]{2})\s*(?:--|#|\/\*|\)|&|$)/"; \
    classtype:web-application-attack; sid:9000007; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then OR true then comment in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"or"; pcre:"/['\"]\)*\s*(?:or|\|\|)\s*(?:true|\d+|['\"]{2})\s*(?:--|#|\/\*|\)|&|$)/"; \
    classtype:web-application-attack; sid:9000008; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE SQLI Numeric AND/OR tautology in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"="; pcre:"/(?:\d|['\")])\s+(?:and|or)\s+(?:\d+\s*(?:=|!=)\s*\d+|['\"][^'\"]{0,20}['\"]\s*=\s*['\"][^'\"]{0,20}['\"])/"; \
    classtype:web-application-attack; sid:9000009; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI Numeric AND/OR tautology opening a body value"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"="; pcre:"/(?:^|&)[^=&]{1,50}=\s*['\"]?-?\d+['\"]?\s+(?:and|or)\s+\d+\s*(?:=|!=)\s*\d+|[\"']\s*:\s*[\"']?-?\d+[\"']?\s+(?:and|or)\s+\d+\s*=\s*\d+/"; \
    classtype:web-application-attack; sid:9000010; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE SQLI Stacked query in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"\;"; pcre:"/\;\s*(?:drop\s+(?:table|database|schema|user|view|index)\s|insert\s+into\s+\w+\s*(?:\(|values|select)|update\s+\w+\s+set\s+\w+\s*=|delete\s+from\s+\w+\s*(?:where|\;|--|#|\)|$)|truncate\s+table\s|alter\s+(?:table|user|database)\s|create\s+(?:table|user|database|function|procedure)\s|exec(?:ute)?\s*(?:\(|@|master|xp_|sp_)|declare\s+@|shutdown\b|waitfor\s+(?:delay|time)\s|select\s+(?:[\d*@(]|null\b|\w+\s*\(|\w+(?:\s*,\s*\w+)*\s+from\s+(?:users?|admin\w*|accounts?|passwords?|members?|customers?|credentials|information_schema)\b))/"; \
    classtype:web-application-attack; sid:9000011; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE SQLI Stacked query in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"\;"; pcre:"/\;\s*(?:drop\s+(?:table|database|schema|user|view|index)\s|insert\s+into\s+\w+\s*(?:\(|values|select)|update\s+\w+\s+set\s+\w+\s*=|delete\s+from\s+\w+\s*(?:where|\;|--|#|\)|$)|truncate\s+table\s|alter\s+(?:table|user|database)\s|create\s+(?:table|user|database|function|procedure)\s|exec(?:ute)?\s*(?:\(|@|master|xp_|sp_)|declare\s+@|shutdown\b|waitfor\s+(?:delay|time)\s|select\s+(?:[\d*@(]|null\b|\w+\s*\(|\w+(?:\s*,\s*\w+)*\s+from\s+(?:users?|admin\w*|accounts?|passwords?|members?|customers?|credentials|information_schema)\b))/"; \
    classtype:web-application-attack; sid:9000012; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then SQL comment in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"'"; pcre:"/'\s*(?:--(?:[^\w]|$)|#|\/\*)/"; \
    classtype:web-application-attack; sid:9000013; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE SQLI Quote then SQL comment in body"; flow:to_server,established; \
