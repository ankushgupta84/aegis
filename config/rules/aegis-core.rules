# ==================================================================================================
# EVASION: encoding tricks that have no honest use in a request. They score 3 so that they tip a
# borderline request but never block a client whose library double-encodes by mistake. The
# payload rules above already see through single and double percent-encoding; these flag the attempt.
# ==================================================================================================

alert http any any -> any any (msg:"AEGIS CORE EVASION Double percent-encoding in raw URI"; flow:to_server,established; \
    http.uri.raw; \
    content:"%25"; pcre:"/%25[0-9a-f]{2}/i"; \
    classtype:web-application-attack; sid:9000601; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE EVASION Double percent-encoding in raw body"; flow:to_server,established; \
    http.request_body; \
    content:"%25"; pcre:"/%25[0-9a-f]{2}/i"; \
    classtype:web-application-attack; sid:9000602; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE EVASION Unicode %u encoding in raw URI"; flow:to_server,established; \
    http.uri.raw; \
    content:"%u"; nocase; pcre:"/%u[0-9a-f]{4}/i"; \
    classtype:web-application-attack; sid:9000603; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE EVASION Overlong UTF-8 lead byte C0 in URI"; flow:to_server,established; \
    http.uri; \
    content:"|c0|"; pcre:"/[\xc0\xc1][\x1c\x80-\xbf]/"; \
    classtype:web-application-attack; sid:9000604; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE EVASION Overlong UTF-8 lead byte C1 in URI"; flow:to_server,established; \
    http.uri; \
    content:"|c1|"; pcre:"/[\xc0\xc1][\x1c\x80-\xbf]/"; \
    classtype:web-application-attack; sid:9000605; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE EVASION Null byte in URI"; flow:to_server,established; \
    http.uri; \
    content:"|00|"; \
    classtype:web-application-attack; sid:9000606; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE EVASION CRLF header injection in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"|0d 0a|"; pcre:"/\r\n(?:set-cookie|location|content-(?:length|type)|http\/1\.[01]|transfer-encoding|x-[a-z-]+)/"; \
    classtype:web-application-attack; sid:9000607; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)

# ==================================================================================================
# SCANNER: user-agents of vulnerability scanners and attack tools. A scanner is not an attack by
# itself, and a defender may run one on purpose, so each scores 3: alone it passes, with any
# other signal (a quote-comment, a single ../) it blocks. Only the user-agent is inspected.
# ==================================================================================================

alert http any any -> any any (msg:"AEGIS CORE SCANNER sqlmap user-agent"; flow:to_server,established; \
    http.user_agent; content:"sqlmap"; nocase; \
    classtype:attempted-recon; sid:9000701; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
