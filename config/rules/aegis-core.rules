    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"sleep"; pcre:"/(?:\band|\bor|\|\||&&|,|\(|\;|\bthen|\belse|\bselect|\+|=)\s*(?:pg_)?sleep\s*\(\s*(?:\d|\$|@|\()/"; \
    classtype:web-application-attack; sid:9000017; rev:1; \
