alert http any any -> any any (msg:"AEGIS CORE XSS iframe tag in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"<iframe"; \
    classtype:web-application-attack; sid:9000112; rev:1; \
    metadata:attack_target Web_Server, score 5, signature_severity Major;)
alert http any any -> any any (msg:"AEGIS CORE XSS iframe tag in body"; flow:to_server,established; \
