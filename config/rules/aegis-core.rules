    http.uri; url_decode; to_lowercase; \
    content:"select"; pcre:"/\bselect\b[^\;]{1,100}?\bfrom\s+(?:users?|admin\w*|accounts?|passwords?|members?|customers?|credentials|logins?|mysql\.\w+|pg_\w+|sqlite_master|sys\w*|dual)\b/"; \
