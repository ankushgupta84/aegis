alert http any any -> any any (msg:"AEGIS CORE XSS alert() probe in URI"; flow:to_server,established; \
    http.uri; url_decode; to_lowercase; \
    content:"alert"; pcre:"/alert\s*[(`]/"; \
    classtype:web-application-attack; sid:9000114; rev:1; \
    metadata:attack_target Web_Server, score 3, signature_severity Minor;)
alert http any any -> any any (msg:"AEGIS CORE XSS alert() probe in body"; flow:to_server,established; \
    http.request_body; url_decode; url_decode; to_lowercase; \
    content:"alert"; pcre:"/alert\s*[(`]/"; \
